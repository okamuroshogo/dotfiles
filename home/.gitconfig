# ~/.gitconfig
#
# マシン固有の設定 (仕事用の user.email など) は ~/.gitconfig.local に書く。
# このファイルの末尾で include している。git 管理しない。

[user]
	name = okamuroshogo
	email = admin@okamu.ro

[init]
	defaultBranch = main

[core]
	excludesfile = ~/.gitignore_global
	quotepath = false          # 日本語ファイル名を \346\... にせずそのまま出す
	precomposeunicode = true   # macOS の濁点分解 (NFD) を正規化する

[color]
	ui = auto

[diff]
	algorithm = histogram      # 読みやすい差分になる
	colorMoved = zebra         # 移動した行と変更した行を区別する
	renames = copies

[merge]
	conflictstyle = zdiff3     # コンフリクト表示に共通の祖先も出す

[pull]
	ff = only                  # 暗黙の merge コミットを作らせない

[push]
	default = simple
	autoSetupRemote = true     # 初回 push で -u を書かなくてよい
	followTags = true

[fetch]
	prune = true               # 消えたリモートブランチを掃除する

[rebase]
	autostash = true

[branch]
	sort = -committerdate      # git branch を最近使った順に

[rerere]
	enabled = true             # 同じコンフリクトの解決を覚える

[alias]
	st = status -sb
	co = checkout
	sw = switch
	br = branch
	cm = commit
	ca = commit --amend
	df = diff
	dfc = diff --cached
	graph = log --graph --all --abbrev-commit --date=relative --pretty=format:'%C(red)%h%Creset -%C(yellow)%d%Creset %s %C(green)(%cr) %C(bold blue)<%an>%Creset'
	undo = reset --soft HEAD^
	ignore-cache = !git rm -r --cached . && git add .

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[include]
	path = ~/.gitconfig.local
