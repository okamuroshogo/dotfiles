#!/bin/bash
#
# dns-switch — 接続中の Wi-Fi が自宅 LAN なら DNS を固定し、
#              それ以外(別のWi-Fi / テザリング / 未接続)なら自動取得(DHCP)に戻す。
#
#              自宅の判定は次をすべて満たしたときだけ:
#                1. デフォルトゲートウェイの MAC アドレスが HOME_ROUTER_MACS のどれか
#                2. SSID が読めた場合は HOME_SSIDS のどれか (伏せられていたら見ない)
#                3. HOME_DNS のどれかが実際に応答する
#
# 使い方:
#   dns-switch              判定して必要なら適用する (launchd から呼ばれる)
#   dns-switch --status     現在の状態を表示するだけ
#   dns-switch --dry-run    何をするか表示するだけ
#
# 設定は /usr/local/etc/dns-switch.conf (リポジトリの config/dns-switch/ が元)。
#
# 設計メモ:
#   - 「望む状態」と「今の状態」を比べて、違うときだけ networksetup を叩く。
#     launchd の WatchPaths が resolv.conf を見ているので、
#     毎回無条件に書き換えると自分の変更で自分が再起動する無限ループになる。
#   - DNS の変更には root が必要なので LaunchDaemon (root) として動かす。

set -uo pipefail

CONF="${DNS_SWITCH_CONF:-/usr/local/etc/dns-switch.conf}"
HOME_SSIDS=()
HOME_SSID=""     # 旧形式 (単一指定)。後方互換のために残してある。
HOME_ROUTER_MACS=()
HOME_DNS=""

# shellcheck source=/dev/null
[[ -r "$CONF" ]] && . "$CONF"

# 単一指定で書かれていても配列に寄せて、以降は配列だけを見る
[[ -n "$HOME_SSID" ]] && HOME_SSIDS+=("$HOME_SSID")

MODE="apply"
case "${1:-}" in
  --status)  MODE="status" ;;
  --dry-run) MODE="dry-run" ;;
  -h|--help) sed -n '3,21p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  "")        ;;
  *)         echo "不明なオプション: $1" >&2; exit 2 ;;
esac

say() { printf '%s dns-switch: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }

# SSID が読めたかどうか。
# macOS 15 以降、位置情報の許可が無いプロセス (この LaunchDaemon も含む) には
# SSID / BSSID が "<redacted>" と伏せて返される。これは SSID ではないので、
# 「読めなかった」として扱う。設定に "<redacted>" を書くと全 Wi-Fi が自宅扱いになる。
ssid_known() {
  [[ -n "$1" && "$1" != "<redacted>" ]]
}

# SSID の条件を満たすか。
# SSID が読めないときや HOME_SSIDS が空のときは判定材料にしない (ゲートウェイ MAC に任せる)。
# 読めたときは HOME_SSIDS のどれかに一致しなければ自宅ではない。
ssid_ok() {
  local ssid="$1" home
  ssid_known "$ssid" || return 0
  (( ${#HOME_SSIDS[@]} )) || return 0
  for home in "${HOME_SSIDS[@]}"; do
    [[ "$ssid" == "$home" ]] && return 0
  done
  return 1
}

# MAC アドレスを比較できる形 (小文字、各オクテット2桁) にそろえる。
# arp は f8:aa:3f:5:1:18 のように先頭の 0 を落とすことがあるため。
normalize_mac() {
  local IFS=: out="" o
  for o in $1; do
    out+="$(printf '%02x' "0x$o" 2>/dev/null):"
  done
  printf '%s' "${out%:}"
}

# インターフェースのデフォルトゲートウェイ (DHCP で配られた router)。
gateway_ip() {
  /usr/sbin/ipconfig getoption "$1" router 2>/dev/null
}

# ゲートウェイの MAC アドレス。ARP に無ければ1回 ping して引き直す。
gateway_mac() {
  local dev="$1" gw="$2" mac
  [[ -n "$gw" ]] || return 0
  mac="$(/usr/sbin/arp -n -i "$dev" "$gw" 2>/dev/null | awk '{ print $4 }')"
  if [[ ! "$mac" =~ : ]]; then
    /sbin/ping -c 1 -t 1 "$gw" >/dev/null 2>&1 || true
    mac="$(/usr/sbin/arp -n -i "$dev" "$gw" 2>/dev/null | awk '{ print $4 }')"
  fi
  [[ "$mac" =~ : ]] && normalize_mac "$mac"
}

# ゲートウェイが自宅のルータかどうか。HOME_ROUTER_MACS が空なら常に自宅ではない。
# テザリングや外の Wi-Fi は SSID が伏せられていても、ここで弾かれる。
router_ok() {
  local mac="$1" home
  [[ -n "$mac" ]] || return 1
  (( ${#HOME_ROUTER_MACS[@]} )) || return 1
  for home in "${HOME_ROUTER_MACS[@]}"; do
    [[ "$mac" == "$(normalize_mac "$home")" ]] && return 0
  done
  return 1
}

# 自宅 DNS のどれかが実際に答えるか。
# MAC が偶然一致した場合や、自宅 DNS が落ちている場合に名前解決できなくなるのを防ぐ。
# dig は @サーバ に直接問い合わせるので、今のシステム DNS 設定に左右されない。
dns_ok() {
  local srv
  for srv in $HOME_DNS; do
    /usr/bin/dig +time=1 +tries=1 +short "@$srv" . NS >/dev/null 2>&1 && return 0
  done
  return 1
}

# Wi-Fi のインターフェース名 (en0 など)。機種によって変わるので毎回引く。
wifi_device() {
  /usr/sbin/networksetup -listallhardwareports 2>/dev/null \
    | awk '/^Hardware Port: Wi-Fi$/ { getline; print $2; exit }'
}

# インターフェースに対応するネットワークサービス名 ("Wi-Fi" など)。
# networksetup はサービス名で指定するのでデバイス名から引き直す。
wifi_service() {
  local dev="$1"
  /usr/sbin/networksetup -listnetworkserviceorder 2>/dev/null \
    | awk -v dev="$dev" '
        /^\(/ && !/Hardware Port:/ { svc = $0; sub(/^\([^)]*\) /, "", svc); next }
        $0 ~ ("Device: " dev "\\)")  { print svc; exit }
      '
}

# 接続中の SSID。未接続なら空文字。
#
# 注意: macOS 14 以降 `networksetup -getairportnetwork` は位置情報の許可が無いと
#       接続中でも "You are not associated with an AirPort network." と答える。
#       そのため ipconfig を主、networksetup を従にしている。
#       さらに ipconfig は切断直後に古い SSID を返すことがあるので、
#       先にインターフェースが active かどうかを見る。
current_ssid() {
  local dev="$1" ssid=""

  /sbin/ifconfig "$dev" 2>/dev/null | grep -q 'status: active' || {
    printf ''
    return 0
  }

  ssid="$(/usr/sbin/ipconfig getsummary "$dev" 2>/dev/null \
    | sed -n 's/^[[:space:]]*SSID[[:space:]]*:[[:space:]]*//p' | head -1)"

  if [[ -z "$ssid" ]]; then
    ssid="$(/usr/sbin/networksetup -getairportnetwork "$dev" 2>/dev/null \
      | sed -n 's/^Current Wi-Fi Network: //p')"
  fi

  printf '%s' "$ssid"
}

# 現在設定されている DNS をスペース区切りで。手動設定なしなら空文字。
current_dns() {
  local svc="$1" out
  out="$(/usr/sbin/networksetup -getdnsservers "$svc" 2>/dev/null)" || return 1
  case "$out" in
    *"aren't any DNS Servers"*|*"DNS Servers set"*) printf '' ;;
    *) printf '%s' "$(printf '%s' "$out" | tr '\n' ' ' | sed 's/[[:space:]]*$//')" ;;
  esac
}

main() {
  local dev svc ssid gw mac reason desired current

  dev="$(wifi_device)"
  if [[ -z "$dev" ]]; then
    [[ "$MODE" == "apply" ]] || say "Wi-Fi インターフェースが見つかりません"
    return 0
  fi

  svc="$(wifi_service "$dev")"
  if [[ -z "$svc" ]]; then
    say "$dev に対応するネットワークサービスが見つかりません"
    return 0
  fi

  ssid="$(current_ssid "$dev")"

  # 未接続なら他は調べない (ARP や dig で待たされないように)
  gw="" mac="" reason="未接続"
  if [[ -n "$ssid" ]]; then
    gw="$(gateway_ip "$dev")"
    mac="$(gateway_mac "$dev" "$gw")"
    if ! router_ok "$mac"; then
      reason="ゲートウェイ ${gw:-なし} (${mac:-MAC不明}) が自宅のルータではない"
    elif ! ssid_ok "$ssid"; then
      reason="SSID '$ssid' が HOME_SSIDS にない"
    elif ! dns_ok; then
      reason="自宅 DNS ($HOME_DNS) が応答しない"
    else
      reason=""
    fi
  fi

  if [[ -z "$reason" && -n "$HOME_DNS" ]]; then
    desired="$HOME_DNS"
  else
    desired=""
  fi

  current="$(current_dns "$svc")"

  if [[ "$MODE" == "status" ]]; then
    printf '  設定ファイル : %s\n' "$CONF"
    if (( ${#HOME_SSIDS[@]} )); then
      printf '  自宅 SSID    : %s\n' "${HOME_SSIDS[0]}"
      local i
      for (( i = 1; i < ${#HOME_SSIDS[@]}; i++ )); do
        printf '               : %s\n' "${HOME_SSIDS[i]}"
      done
    else
      printf '  自宅 SSID    : (未設定)\n'
    fi
    if (( ${#HOME_ROUTER_MACS[@]} )); then
      printf '  自宅ルータMAC: %s\n' "${HOME_ROUTER_MACS[*]}"
    else
      printf '  自宅ルータMAC: (未設定。常に自宅ではないと判定される)\n'
    fi
    printf '  自宅 DNS     : %s\n' "${HOME_DNS:-(未設定)}"
    printf '  インターフェース: %s (サービス名: %s)\n' "$dev" "$svc"
    if [[ "$ssid" == "<redacted>" ]]; then
      printf '  接続中の SSID: (macOS により伏せられている。判定には使わない)\n'
    else
      printf '  接続中の SSID: %s\n' "${ssid:-(未接続)}"
    fi
    printf '  ゲートウェイ : %s (%s)\n' "${gw:-なし}" "${mac:-MAC不明}"
    printf '  自宅判定     : %s\n' "${reason:-自宅}"
    printf '  現在の DNS   : %s\n' "${current:-自動取得 (DHCP)}"
    printf '  あるべき DNS : %s\n' "${desired:-自動取得 (DHCP)}"
    if [[ "$current" == "$desired" ]]; then
      printf '  判定         : 一致 (変更不要)\n'
    else
      printf '  判定         : 不一致 (次回実行で変更される)\n'
    fi
    return 0
  fi

  # 既に望む状態なら何もしない。これが無限ループ防止の要。
  if [[ "$current" == "$desired" ]]; then
    return 0
  fi

  if [[ "$MODE" == "dry-run" ]]; then
    say "(dry-run) ${reason:-自宅} -> DNS を '${desired:-Empty}' にする"
    return 0
  fi

  if [[ "$EUID" -ne 0 ]]; then
    say "DNS の変更には root が必要です (sudo dns-switch)" >&2
    return 1
  fi

  if [[ -n "$desired" ]]; then
    # shellcheck disable=SC2086
    /usr/sbin/networksetup -setdnsservers "$svc" $desired \
      && say "自宅 (ゲートウェイ $gw / $mac) -> DNS を $desired に設定しました"
  else
    /usr/sbin/networksetup -setdnsservers "$svc" Empty \
      && say "自宅ではない ($reason) -> DNS を自動取得に戻しました"
  fi

  /usr/bin/dscacheutil -flushcache 2>/dev/null || true
  /usr/bin/killall -HUP mDNSResponder 2>/dev/null || true
}

main
