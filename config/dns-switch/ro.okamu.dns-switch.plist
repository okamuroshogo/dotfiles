<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ro.okamu.dns-switch</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/sbin/dns-switch</string>
  </array>

  <!-- 起動時に一度 -->
  <key>RunAtLoad</key>
  <true/>

  <!-- ネットワークの状態が変わったときに走らせる -->
  <key>WatchPaths</key>
  <array>
    <string>/var/run/resolv.conf</string>
    <string>/Library/Preferences/SystemConfiguration/com.apple.airport.preferences.plist</string>
    <string>/Library/Preferences/SystemConfiguration/preferences.plist</string>
  </array>

  <!-- 取りこぼし対策の保険。中身は冪等なので空振りしても害がない -->
  <key>StartInterval</key>
  <integer>300</integer>

  <key>StandardOutPath</key>
  <string>/var/log/dns-switch.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/dns-switch.log</string>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
